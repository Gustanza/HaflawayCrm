rules_version = '2';

// =============================================================================
// Haflaway CRM — Firestore security rules
//
// TODO.md §4: rules ARE the access-control layer, not the UI. Identity/org plumbing below
// (orgs, users, usersPublic, teams, leadPhoneIndex) is unchanged from the legacy plan and
// already proven. The `leads` / `leads/{id}/deals` / `leads/{id}/activities` blocks are new,
// for the lean per-product-deal model in TODO.md §3.
//
// Authorisation reads CUSTOM CLAIMS first (role, teamId, orgId, active), falling back to the
// `users/{uid}` document only for an account not yet synced — see the comment on `role()`
// below for why.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity helpers — unchanged from the legacy plan
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function claim(name) {
      return request.auth.token.get(name, '');
    }

    function profileRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return exists(profileRef());
    }

    function profile() {
      return get(profileRef()).data;
    }

    /** True when this account has been provisioned by a script — the no-read fast path. */
    function hasClaims() {
      return isSignedIn() && claim('role') != '';
    }

    function role() {
      return hasClaims() ? claim('role') : (hasProfile() ? profile().role : '');
    }

    function myTeam() {
      return hasClaims() ? claim('teamId') : (hasProfile() ? profile().teamId : '');
    }

    function myOrg() {
      return hasClaims() ? claim('orgId') : (hasProfile() ? profile().orgId : '');
    }

    function isActive() {
      return isSignedIn() && (
        hasClaims()
          ? request.auth.token.get('active', false) == true
          : (hasProfile() && profile().isActive == true)
      );
    }

    function uid() {
      return request.auth.uid;
    }

    function hasRole(roles) {
      return isActive() && role() in roles;
    }

    function isAdmin()   { return hasRole(['admin']); }
    function isManager() { return hasRole(['admin', 'manager']); }

    // ---------------------------------------------------------------------
    // Data helpers
    // ---------------------------------------------------------------------

    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }

    function changedKeys() {
      return incoming().diff(existing()).affectedKeys();
    }

    function onlyChanged(allowed) {
      return changedKeys().hasOnly(allowed);
    }

    function unchanged(field) {
      return !(field in changedKeys());
    }

    function inMyOrg() {
      return incoming().orgId == myOrg();
    }

    function readingMyOrg() {
      return existing().orgId == myOrg();
    }

    function notClobberingAnotherOrg() {
      return resource == null || resource.data.orgId == myOrg();
    }

    function userRef(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function targetUserInMyOrg(userId) {
      return exists(userRef(userId)) && get(userRef(userId)).data.orgId == myOrg();
    }

    function createStamped() {
      return incoming().createdBy == uid()
          && incoming().updatedBy == uid()
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
    }

    function updateStamped() {
      return incoming().updatedBy == uid()
          && incoming().updatedAt == request.time
          && unchanged('createdBy')
          && unchanged('createdAt');
    }

    // ---------------------------------------------------------------------
    // orgs — self-service registration, unchanged from the legacy plan
    // ---------------------------------------------------------------------

    function orgRef(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId);
    }

    function isOrgOwner(orgId) {
      return exists(orgRef(orgId)) && get(orgRef(orgId)).data.ownerUid == uid();
    }

    function validOrgIdFormat(orgId) {
      return orgId.matches('^[a-z0-9-]{2,40}$');
    }

    match /orgs/{orgId} {
      allow get:  if resource == null
                  || (isSignedIn() && myOrg() == orgId)
                  || (isSignedIn() && resource.data.ownerUid == uid());
      allow list: if false;

      allow create: if isSignedIn()
                    && validOrgIdFormat(orgId)
                    && incoming().orgId == orgId
                    && incoming().ownerUid == uid()
                    && incoming().createdBy == uid()
                    && incoming().createdAt == request.time
                    && incoming().name is string
                    && incoming().name.size() > 0
                    && incoming().name.size() <= 200;

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if resource == null
                  ? isAdmin()
                  : (isActive() && readingMyOrg()
                     && (userId == uid() || isManager()));

      allow create: if (isAdmin() && inMyOrg())
                    || (isSignedIn()
                        && userId == uid()
                        && incoming().role == 'admin'
                        && incoming().isActive == true
                        && isOrgOwner(incoming().orgId));

      allow update: if isAdmin() && readingMyOrg() && updateStamped()
                    || (isActive()
                        && userId == uid()
                        && onlyChanged(['displayName', 'photoPath', 'locale', 'phone',
                                        'fcmTokens', 'lastActiveAt', 'updatedAt', 'updatedBy'])
                        && updateStamped());

      allow delete: if false;
    }

    match /usersPublic/{userId} {
      allow read:  if isActive() && readingMyOrg();
      allow write: if (isAdmin() && inMyOrg() && notClobberingAnotherOrg())
                   || (isSignedIn() && userId == uid() && isOrgOwner(incoming().orgId));
    }

    match /teams/{teamId} {
      allow read:   if isActive() && readingMyOrg();
      allow write:  if isAdmin() && inMyOrg() && notClobberingAnotherOrg();
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // leads — the core object. No pipeline stage: a lead's PRODUCTS (deals,
    // below) close independently. TODO.md §3.
    // ---------------------------------------------------------------------

    function ownsLead()      { return existing().ownerId == uid(); }
    function leadInMyTeam()  { return existing().teamId == myTeam(); }
    function leadUnowned()   { return existing().ownerId == null; }

    function canReadLead() {
      return isActive() && readingMyOrg() && (
        isAdmin()
        || ownsLead()
        || leadUnowned()
        || (isManager() && leadInMyTeam())
      );
    }

    function canWriteLead() {
      return isActive() && readingMyOrg() && (
        isAdmin()
        || ownsLead()
        || (isManager() && leadInMyTeam())
      );
    }

    // -------------------------------------------------------------------
    // Sub-collection authorisation for a document reached via a FIXED leadId — a `get`, or a
    // `list` scoped to exactly one lead's subcollection (Lead Detail's deal cards / timeline).
    // Fetching the parent by `leadId` is provable in both cases because `leadId` is a single
    // known value for that request, not one that varies across many results.
    //
    // This does NOT extend to a true collectionGroup('deals'|'activities') query spanning
    // every lead — there, `leadId` varies per potential match, so Firestore cannot prove a
    // parent get() and rejects the query outright ("Avoid a document read for collection
    // group queries" is Firestore's own guidance). The dashboard's collection-group reads
    // are authorised separately, below, using only `resource.data` (hence `orgId` is
    // denormalised onto every deal and activity — TODO.md §3).
    // -------------------------------------------------------------------

    function leadRef(leadId) {
      return /databases/$(database)/documents/leads/$(leadId);
    }

    function parentLead(leadId) {
      return get(leadRef(leadId)).data;
    }

    function canReadLeadById(leadId) {
      return isActive()
          && exists(leadRef(leadId))
          && parentLead(leadId).orgId == myOrg()
          && (
            isAdmin()
            || parentLead(leadId).ownerId == uid()
            || parentLead(leadId).ownerId == null
            || (isManager() && parentLead(leadId).teamId == myTeam())
          );
    }

    function canWriteLeadById(leadId) {
      return isActive()
          && exists(leadRef(leadId))
          && parentLead(leadId).orgId == myOrg()
          && (
            isAdmin()
            || parentLead(leadId).ownerId == uid()
            || (isManager() && parentLead(leadId).teamId == myTeam())
          );
    }

    // A collection-group read authorised purely from the document's own denormalised orgId
    // plus a role check — provable for any query that filters `orgId == myOrg()`, which is
    // mandatory client-side (see queries.js). Managers/admins only: agents never issue a
    // cross-lead collection-group query in this product; their own lead's deals/activities
    // are read via the single-lead `list`, authorised by `canReadLeadById` instead.
    //
    // Deliberately used ONLY from the top-level `match /{path=**}/deals|activities` blocks
    // below, never combined with a `canReadLeadById()` get() in the same `allow` expression.
    // Firestore's list-provability check rejects the WHOLE boolean expression the instant a
    // get() appears anywhere in it with a path that varies per document (which `leadId` does
    // across a true collection-group query) — it does not short-circuit a `||` the way a
    // normal evaluator would. Confirmed by `tests/rules/collectiongroup.rules.test.js`
    // failing outright when this was combined with `canReadLeadById(leadId)` in one `allow
    // list`. Firestore DOES let multiple `match` blocks matching the same document OR
    // together, so the fix is two separate blocks instead of one combined condition.
    function canReadOrgWide(data) {
      return isActive() && isManager() && data.orgId == myOrg();
    }

    match /leads/{leadId} {
      allow read: if canReadLead();

      allow create: if isActive()
                    && hasRole(['admin', 'manager', 'agent'])
                    && inMyOrg()
                    && createStamped()
                    && (isManager() || incoming().ownerId == uid());

      allow update: if canWriteLead()
                    && updateStamped()
                    && unchanged('orgId')
                    // Anti-poaching: only a manager or admin reassigns a lead.
                    && (unchanged('ownerId') || isManager())
                    && (unchanged('previousOwnerIds') || isManager());

      // Hard delete — admin only. leads.service.js empties `deals` and `activities` FIRST
      // and removes this document LAST, because the child rules above require the parent
      // to still exist for a non-admin read; the admin cascade below is the exception.
      allow delete: if isAdmin() && readingMyOrg();

      // ---------------------------------------------------------------
      // deals — one per product the lead has engaged with. Closes independently per
      // product (TODO.md §3): "closed for reminders, still open for the invitation".
      // ---------------------------------------------------------------
      match /deals/{dealId} {
        allow get:  if canReadLeadById(leadId);
        allow list: if canReadLeadById(leadId);

        allow create: if isActive()
                      && canWriteLeadById(leadId)
                      && incoming().orgId == myOrg()
                      && incoming().status == 'open'
                      && createStamped();

        allow update: if isActive()
                      && canWriteLeadById(leadId)
                      && updateStamped()
                      && unchanged('orgId')
                      && (
                        unchanged('status')
                        || (incoming().status == 'closed_won'
                            && incoming().closedAt == request.time
                            && incoming().closedBy == uid())
                        || (incoming().status == 'closed_lost'
                            && incoming().closedAt == request.time
                            && incoming().closedBy == uid()
                            && incoming().lostReason is string
                            && incoming().lostReason.size() > 0)
                        // Reopening a closed deal — manager/admin only, mirrors the lead
                        // reassignment gate: it un-counts a win or a loss on the dashboard.
                        || (incoming().status == 'open' && isManager())
                      );

        allow delete: if isAdmin() && canReadLeadById(leadId);
      }

      // ---------------------------------------------------------------
      // activities — APPEND-ONLY contact log. `nextFollowUpAt` presence is enforced by the
      // client form (required unless the activity records a closing outcome), not here —
      // the rule cannot see the sibling deal write in the same request without a
      // transaction, and this is not a figure anyone's pay depends on.
      // ---------------------------------------------------------------
      match /activities/{activityId} {
        allow get:  if canReadLeadById(leadId);
        allow list: if canReadLeadById(leadId);

        allow create: if isActive()
                      && canWriteLeadById(leadId)
                      && incoming().orgId == myOrg()
                      && incoming().byUserId == uid()
                      && incoming().at == request.time
                      && incoming().isVoided == false;

        // A correction voids the entry with a stated reason. Nothing else may change.
        allow update: if isActive()
                      && canWriteLeadById(leadId)
                      && existing().isVoided == false
                      && incoming().isVoided == true
                      && incoming().voidedBy == uid()
                      && incoming().voidReason is string
                      && incoming().voidReason.size() > 0
                      && incoming().voidedAt == request.time
                      && onlyChanged(['isVoided', 'voidedBy', 'voidReason', 'voidedAt']);

        allow delete: if isAdmin() && canReadLeadById(leadId);
      }
    }

    // ---------------------------------------------------------------------
    // Collection-group access for the dashboard (managers/admins only). Separate top-level
    // blocks, deliberately NOT merged into the nested `leads/{leadId}/deals|activities`
    // blocks above — see the comment on `canReadOrgWide()`. Firestore ORs every `match`
    // block that matches a given document, so this adds a second way in for the
    // collection-group case without touching the per-lead path's own rules.
    // ---------------------------------------------------------------------
    match /{path=**}/deals/{dealId} {
      allow list, get: if canReadOrgWide(resource.data);
    }

    match /{path=**}/activities/{activityId} {
      allow list, get: if canReadOrgWide(resource.data);
    }

    // ---------------------------------------------------------------------
    // leadPhoneIndex — duplicate lock, unchanged from the legacy plan (TODO.md §3).
    // Document ID is `{orgId}_{phoneNormalized}`.
    // ---------------------------------------------------------------------
    match /leadPhoneIndex/{key} {
      allow read:   if isActive() && key.split('_')[0] == myOrg();
      allow create: if isActive()
                    && hasRole(['admin', 'manager', 'agent'])
                    && key.split('_')[0] == myOrg()
                    && incoming().orgId == myOrg()
                    && (isManager() || incoming().ownerId == uid());
      allow update: if isManager() && readingMyOrg();
      allow delete: if isAdmin() && readingMyOrg();
    }

    // ---------------------------------------------------------------------
    // Default deny — anything not matched above is forbidden.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

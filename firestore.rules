rules_version = '2';

// =============================================================================
// Haflaway CRM — Firestore security rules
//
// TEMPORARY DEV MODE: wide open to any signed-in user, no role/org/ownership checks at
// all. This is deliberate, at the owner's request, to unblock local click-through testing
// without fighting claims/role setup first.
//
// The real rules (role-scoped leads, per-product deal close rules, append-only activities,
// org isolation, 93 passing tests) are NOT gone — they're in git history. Restore them with:
//   git log --oneline -- firestore.rules
//   git show <commit-before-this-one>:firestore.rules > firestore.rules
// (the commit titled "Phase 1: rewrite firestore.rules/indexes for the per-product-deal
// model" is the one to restore from, or any later commit that still has the real rules).
//
// DO NOT deploy this to a real/production Firebase project. It is safe only against the
// local emulator.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

# Copy to functions/.env.haflawaycrm (the live project) and fill in. Not secret, but keep real values out of git.
# The SMTZ API key is NOT set here — it is a secret:  firebase functions:secrets:set SMTZ_API_KEY
SMTZ_SENDER_ID=HAFLAWAY
SMS_STAFF_EMAILS=you@example.com,colleague@example.com
SMS_PAYMENT_INFO=
SMS_DRY_RUN=false
SMTZ_BASE_URL=https://messaging-api.haflaway.com/api/v1
